rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Role comes ONLY from the custom claim set server-side by
    // functions/src/auth/completeRegistration.ts — never from a
    // client-writable field. This is the enforcement point for every
    // role check in these rules.
    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // users/{uid} — one profile document per account.
    // Created and role-stamped only by the trusted backend
    // (web/api/completeRegistration.ts, via the Admin SDK which bypasses
    // these rules entirely), so client-side create/delete are always
    // denied. Clients may only edit their own non-sensitive display fields.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'languagePreference', 'updatedAt']);
      allow create, delete: if false;
    }

    // wellbeingAssessments/{id} — written only by
    // web/api/submitWellbeingAssessment.ts (Admin SDK bypasses these
    // rules), so this is read-only from the client, own-assessments-only.
    match /wellbeingAssessments/{assessmentId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // aiConversations/{uid}/messages/{id} — the AI chat transcript.
    // Written only by web/api/aiChat.ts so a client can never forge an
    // "assistant" message or bypass the safety filter; readable only by
    // its owner for the live chat UI.
    match /aiConversations/{uid}/messages/{messageId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // safetyEvents/{id} — admin-only. Never client-writable; never
    // client-readable either, since it can include a short excerpt of a
    // flagged message (spec §83: minimize exposure of chat content).
    match /safetyEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // helperTraining/{uid} — a helper's own lesson/quiz progress.
    // Written only by web/api/submitLessonQuiz.ts and
    // web/api/submitFinalTest.ts.
    match /helperTraining/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // trainingAttempts/{uid}/attempts/{id} — final-test attempt history.
    // Written only by web/api/submitFinalTest.ts.
    match /trainingAttempts/{uid}/attempts/{attemptId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // supportSessions/{id} — a client<->helper session. Readable only by
    // its two participants (or admin); written only by the trusted
    // backend so the state machine (spec §54) can't be bypassed or
    // forged from the client.
    match /supportSessions/{sessionId} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid
            || resource.data.helperUid == request.auth.uid
            || isAdmin());
      allow write: if false;

      // messages/{id} — readable by the same two participants. A
      // blocked helper message is stored with blocked:true and a fixed
      // placeholder string, never the original prohibited text, so
      // there's nothing extra to protect by hiding it from the client.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/supportSessions/$(sessionId)).data.clientUid == request.auth.uid
              || get(/databases/$(database)/documents/supportSessions/$(sessionId)).data.helperUid == request.auth.uid
              || isAdmin());
        allow write: if false;
      }
    }

    // reviews/{id} — readable by the client who wrote it, or the
    // helper/professional it's about. Written only by
    // web/api/submitHelperReview.ts and submitProfessionalReview.ts,
    // both of which enforce one review per completed session/appointment
    // server-side.
    match /reviews/{reviewId} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid
            || resource.data.helperUid == request.auth.uid
            || resource.data.professionalUid == request.auth.uid
            || isAdmin());
      allow write: if false;
    }

    // professionals/{uid}/availabilitySlots/{id} — read/written only via
    // the trusted backend (getProfessionalSlots.ts / addAvailabilitySlot.ts
    // / bookAppointment.ts) so slot booking stays race-safe; no direct
    // client access needed.
    match /professionals/{uid}/availabilitySlots/{slotId} {
      allow read, write: if false;
    }

    // appointments/{id} — readable by its client, its professional, or
    // admin. Written only by the trusted backend (bookAppointment.ts,
    // razorpayWebhook.ts, completeAppointment.ts, ...).
    match /appointments/{appointmentId} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid
            || resource.data.professionalUid == request.auth.uid
            || isAdmin());
      allow write: if false;
    }

    // payments/{id} — admin-only. Payment status is surfaced to users via
    // the appointment doc, not this collection directly.
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // certificates/{id} — intentionally public read (spec §37: a
    // certificate needs a public verification URL/QR code). Written only
    // by web/api/_lib/certificates.ts.
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if false;
    }

    // adminAuditLogs/{id} — admin-only, append-only from the trusted
    // backend (web/api/_lib/auditLog.ts).
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // reports/{id} — a client/helper filing a concern (spec §56).
    // Readable by whoever filed it and by admin; never by the person
    // being reported. Written only by web/api/submitReport.ts.
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Default-deny everything else. Each later phase adds its own
    // explicit match block above this line — nothing is ever left open
    // by omission.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
