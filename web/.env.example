# Firebase project config, from:
# Firebase Console > Project settings (gear icon) > General tab > Your apps > Web app > SDK setup and configuration
#
# These values are NOT secret — Firebase's security model expects this config to ship in the
# frontend bundle. What actually protects your data is firestore.rules / storage.rules, not
# hiding these values. See docs/FIREBASE_SETUP.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firebase Emulator Suite (npm run emulators at the repo
# root) instead of your live Firebase project. Keep "false" unless you're running emulators.
VITE_USE_FIREBASE_EMULATORS=false
