# Firebase project config, from:
# Firebase Console > Project settings (gear icon) > General tab > Your apps > Web app > SDK setup and configuration
#
# These values are NOT secret — Firebase's security model expects this config to ship in the
# frontend bundle. What actually protects your data is firestore.rules / storage.rules, not
# hiding these values. See docs/FIREBASE_SETUP.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firestore/Auth emulators instead of your live Firebase
# project. Keep "false" unless you're running `firebase emulators:start`.
VITE_USE_FIREBASE_EMULATORS=false

# --- Server-only (used by web/api/*.ts, never sent to the browser) ---
# See docs/VERCEL_SETUP.md for how to generate/obtain each of these.

# The entire content of a Firebase service-account JSON key file, as one line.
FIREBASE_SERVICE_ACCOUNT_KEY=

# See docs/GEMINI_SETUP.md (added in Phase 2).
GEMINI_API_KEY=

# See docs/VIDEO_SETUP.md (added in Phase 4).
ZEGOCLOUD_APP_ID=
ZEGOCLOUD_SERVER_SECRET=
ZEGOCLOUD_APP_SIGN=
ZEGOCLOUD_CALLBACK_SECRET=

# See docs/RESEND_SETUP.md.
RESEND_API_KEY=
